# ==========================================
# ROS / ROS 2 Build & Workspace Directories
# ==========================================
# ROS 1 (catkin)
devel/
logs/

# ROS 2 (colcon)
# NOTE:
# 先頭に "/" を付けるとリポジトリ直下だけが対象になり、
# ros2_ws/build や ros2_ws/src/install のような
# 下位ディレクトリの生成物が追跡され続けてしまう。
# colcon はどの階層で実行されてもこの3つを作るため、
# 階層を問わないパターンで無視する。
build/
install/
log/
build_isolated/
devel_isolated/
install_isolated/

# ==========================================
# Python Specific
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environment
.venv/
venv/
ENV/
env/

# Python packaging & distribution
.eggs/
*.egg-info/
*.egg
dist/
sdist/

# ==========================================
# IDEs & Editors
# ==========================================
# VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json

# CLion / PyCharm / IntelliJ
.idea/

# Vim / Emacs
*.swp
*~
\#*\#

# ==========================================
# OS & System Files
# ==========================================
.DS_Store
Thumbs.db
